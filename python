import json
import time
import gevent
from locust import HttpUser, task, between, events
import websocket

class TransitWebSocketUser(HttpUser):
    wait_time = between(1, 5)
    
    def on_start(self):
        """Establish a WebSocket connection when the simulated user spawns."""
        ws_url = self.host.replace("http", "ws") + "/ws/fleet"
        self.ws = websocket.create_connection(ws_url)
        
        # Start a background greenlet to listen for incoming stream broadcasts
        def receive():
            while True:
                try:
                    start_time = time.time()
                    msg = self.ws.recv()
                    response_time = int((time.time() - start_time) * 1000)
                    events.request.fire(
                        request_type="WSRecv",
                        name="fleet_position_update",
                        response_time=response_time,
                        response_length=len(msg),
                        exception=None,
                    )
                except websocket.WebSocketConnectionClosedException:
                    break
                    
        gevent.spawn(receive)

    @task
    def keepalive(self):
        """Simulate periodic client pings to keep the WebSocket alive."""
        self.ws.send(json.dumps({"action": "ping"}))

    def on_stop(self):
        self.ws.close()
